SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
NUM_PROXIES=1
LOG_LEVEL=DEBUG

# Neon connection string. GitHub Actions still uses discrete DB_* vars.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GEMINI_API_KEY=your-google-ai-studio-key
# Optional. Defaults are free-tier Gemini models.
# GEMINI_ROUTER_MODEL=gemini-3.6-flash
# GEMINI_INSTRUCTOR_MODEL=gemini-3.6-flash

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=profile-images
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MEMBERSHIP_PRICE_ID=
STRIPE_TOKEN_PACK_200K_PRICE_ID=

# Gmail SMTP. Only used by POST /feedback. Leave blank if you will not send mail locally.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FEEDBACK_RECIPIENT_EMAIL=
